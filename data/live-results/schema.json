{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaobaobao0916-cpu.github.io/sports-analytics/data/live-results/schema.json",
  "title": "V4 滚球推送结果归档",
  "description": "公开归档契约。只保存展示与核验所需字段，不含推送渠道 ID、接收人、凭据或完整内部通知对象。NULL 一律保持 null，禁止转 0。",
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "push_id", "match_id", "sport", "league", "home_team", "away_team",
        "push_sent_at_utc", "push_minute_display", "push_minute_value",
        "push_home_score", "push_away_score", "market_period", "market_type",
        "market_line", "alert_level", "record_class", "model_score", "send_status",
        "match_status", "final_home_score", "final_away_score",
        "half_time_home_score", "half_time_away_score", "full_time_goals",
        "goals_after_push", "goal_result_status", "settled_at_utc", "source_updated_at_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "push_id": {"type": "string", "minLength": 8},
        "match_id": {"type": "string", "minLength": 3},
        "sport": {"const": "football"},
        "league": {"type": ["string", "null"]},
        "home_team": {"type": ["string", "null"]},
        "away_team": {"type": ["string", "null"]},
        "push_sent_at_utc": {"type": "string", "format": "date-time"},
        "push_sent_at_local": {"type": "string"},
        "push_minute_display": {"type": ["string", "null"]},
        "push_minute_value": {"type": ["integer", "null"]},
        "push_home_score": {"type": ["integer", "null"]},
        "push_away_score": {"type": ["integer", "null"]},
        "market_period": {"type": ["string", "null"]},
        "market_type": {"type": ["string", "null"], "enum": ["OU", "AH", null]},
        "market_line": {"type": ["string", "null"]},
        "market_odds_over": {"type": ["number", "null"]},
        "market_odds_under": {"type": ["number", "null"]},
        "alert_level": {"enum": ["formal", "soft"]},
        "record_class": {"enum": ["prediction", "observation"]},
        "signal_type": {"type": "string"},
        "model_score": {"type": ["number", "null"]},
        "send_status": {"enum": ["DELIVERED", "UNCONFIRMED"]},
        "match_status": {"type": ["string", "null"], "enum": ["FT", "LIVE", "POSTPONED", "ABANDONED", null]},
        "final_home_score": {"type": ["integer", "null"]},
        "final_away_score": {"type": ["integer", "null"]},
        "half_time_home_score": {"type": ["integer", "null"]},
        "half_time_away_score": {"type": ["integer", "null"]},
        "full_time_goals": {"type": ["integer", "null"]},
        "goals_after_push": {"type": ["integer", "null"]},
        "goal_result_status": {"enum": ["HIT", "MISS", "PENDING", "REVIEW", "ABNORMAL"]},
        "result_note": {"type": ["string", "null"]},
        "settled_at_utc": {"type": ["string", "null"]},
        "source_updated_at_utc": {"type": ["string", "null"]}
      }
    },
    "summary": {
      "type": "object",
      "required": ["push_total", "formal", "soft", "settled", "hit", "miss", "pending", "review", "abnormal"],
      "additionalProperties": true,
      "properties": {
        "push_total": {"type": "integer", "minimum": 0},
        "formal": {"type": "integer", "minimum": 0},
        "soft": {"type": "integer", "minimum": 0},
        "settled": {"type": "integer", "minimum": 0},
        "hit": {"type": "integer", "minimum": 0},
        "miss": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "review": {"type": "integer", "minimum": 0},
        "abnormal": {"type": "integer", "minimum": 0},
        "goal_after_push_count": {"type": "integer", "minimum": 0},
        "hit_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "hit_rate_denominator": {"type": "integer", "minimum": 0}
      }
    }
  },
  "oneOf": [
    {
      "title": "day",
      "type": "object",
      "required": ["schema_version", "date", "timezone", "generated_at_utc", "summary", "records"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "live-results-day-1"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "timezone": {"const": "Asia/Shanghai"},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "summary": {"$ref": "#/$defs/summary"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
      }
    },
    {
      "title": "index",
      "type": "object",
      "required": ["schema_version", "timezone", "generated_at_utc", "days"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "live-results-index-1"},
        "timezone": {"const": "Asia/Shanghai"},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "file", "push_total", "formal", "soft", "settled", "hit", "miss", "pending", "review", "abnormal"],
            "additionalProperties": false,
            "properties": {
              "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "file": {"type": "string", "pattern": "^days/\\d{4}-\\d{2}-\\d{2}\\.json$"},
              "push_total": {"type": "integer", "minimum": 0},
              "formal": {"type": "integer", "minimum": 0},
              "soft": {"type": "integer", "minimum": 0},
              "settled": {"type": "integer", "minimum": 0},
              "hit": {"type": "integer", "minimum": 0},
              "miss": {"type": "integer", "minimum": 0},
              "pending": {"type": "integer", "minimum": 0},
              "review": {"type": "integer", "minimum": 0},
              "abnormal": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  ]
}
